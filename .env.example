# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (Neon PostgreSQL / Local PostgreSQL)
# Example Neon connection string: postgresql://username:password@ep-example-pooler.region.aws.neon.tech/alwar_internship?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/alwar_internship?schema=public"

# Admin Authentication & Security
AUTH_SECRET="super-secure-jwt-secret-key-replace-in-production-2026-alwar-cyber"
ADMIN_EMAIL="admin@alwarpolice.gov.in"
ADMIN_PASSWORD="your-secure-admin-password-here"

# Application Base URLs
FRONTEND_URL="http://localhost:5173"
PUBLIC_APP_URL="http://localhost:5173"

# Storage Configuration (LOCAL | VERCEL_BLOB | S3 | DB_BACKUP)
STORAGE_PROVIDER="LOCAL"
STORAGE_DIR="uploads/resumes"

# Optional Cloud Storage (if STORAGE_PROVIDER=VERCEL_BLOB or S3)
BLOB_READ_WRITE_TOKEN=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="ap-south-1"
AWS_S3_BUCKET=""

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=2000
REGISTRATION_RATE_LIMIT_WINDOW_MS=900000
REGISTRATION_RATE_LIMIT_MAX=1000
LOGIN_RATE_LIMIT_MAX=5
WHATSAPP_GROUP_URL="https://chat.whatsapp.com/IMDlwTEFRtK5DSOUyavJ2P?s=cl&p=a&mlu=4&ilr=4"

